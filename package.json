{
	"name": "tinymarkdwn",
	"version": "1.1.2",
	"description": "A tiny, fast Markdown parser and renderer with no dependencies, written in vanilla JavaScript for both browser and Node.js environments.",
	"license": "MIT",
	"main": "./dist/tinymarkdwn.min.js",
	"exports": {
		".": {
			"import": "./dist/tinymarkdwn.mjs",
			"require": "./dist/tinymarkdwn.min.js",
			"default": "./dist/tinymarkdwn.min.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/build.js",
		"test": "node tests/test.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JMcrafter26/tinymarkdwn.git"
	},
	"bugs": {
		"url": "https://github.com/JMcrafter26/tinymarkdwn/issues"
	},
	"homepage": "https://github.com/JMcrafter26/tinymarkdwn",
	"keywords": [
		"markdown",
		"parser",
		"renderer",
		"tiny",
		"lightweight",
		"fast",
		"no-dependencies",
		"vanilla-js",
		"browser",
		"nodejs"
	],
	"devDependencies": {
		"terser": "^5.50.0"
	}
}
